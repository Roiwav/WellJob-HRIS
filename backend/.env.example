# ==========================================
# WELLJOB HRIS BACKEND ENVIRONMENT TEMPLATE
# ==========================================
#
# Copy this file to:
#   backend/.env
#
# Never commit real passwords, JWT secrets,
# private IP credentials, or production secrets.
#
# ==========================================
# DATABASE
# ==========================================
#
# DB_HOST:
# Hostname or IP address of the MySQL server.
#
# Examples:
#   localhost
#   192.168.1.10
#   100.x.x.x          # Tailscale/LAN example
#
DB_HOST=

# Default MySQL port is 3306.
DB_PORT=3306

DB_USER=
DB_PASSWORD=
DB_NAME=

# ==========================================
# BACKEND SERVER
# ==========================================
#
# Port used by the Node.js/Express backend.
#
PORT=5000

# ==========================================
# AUTHENTICATION
# ==========================================
#
# Use a long, random, private value.
# Never reuse the example text below as a real secret.
#
JWT_SECRET=

# ==========================================
# FRONTEND / CORS
# ==========================================
#
# Exact browser origin allowed to call the backend.
#
# IMPORTANT:
# - Include protocol and port when applicable.
# - Do NOT add a trailing slash.
# - This value must match the actual deployed frontend origin.
#
# Local Vite development example:
#   FRONTEND_ORIGIN=http://localhost:5173
#
# LAN example:
#   FRONTEND_ORIGIN=http://192.168.1.20:5173
#
FRONTEND_ORIGIN=http://localhost:5173

# ==========================================
# PUBLIC BACKEND ORIGIN
# ==========================================
#
# Base origin used by backend code when it must build
# absolute URLs for documents/evidence or API resources.
#
# IMPORTANT:
# - Use the backend origin only.
# - Do NOT append /api.
# - Do NOT add a trailing slash.
#
# Local example:
#   API_BASE_URL=http://localhost:5000
#
# LAN/Tailscale example:
#   API_BASE_URL=http://100.x.x.x:5000
#
API_BASE_URL=http://localhost:5000
