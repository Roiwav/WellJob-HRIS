# ==========================================
# WELLJOB HRIS FRONTEND ENVIRONMENT TEMPLATE
# ==========================================
#
# Copy this file to:
#   frontend/.env
#
# Vite exposes only variables prefixed with VITE_.
# Never place passwords, JWT secrets, or database
# credentials in frontend environment files.
#
# ==========================================
# BACKEND API ORIGIN
# ==========================================
#
# Set this to the backend origin only.
#
# IMPORTANT:
# - Include the protocol (http:// or https://).
# - Include the backend port when applicable.
# - Do NOT append /api.
# - Do NOT add a trailing slash.
#
# Local development example:
#   VITE_API_BASE_URL=http://localhost:5000
#
# LAN example:
#   VITE_API_BASE_URL=http://192.168.1.10:5000
#
# Tailscale example:
#   VITE_API_BASE_URL=http://100.x.x.x:5000
#
VITE_API_BASE_URL=http://localhost:5000
